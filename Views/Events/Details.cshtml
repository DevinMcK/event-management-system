@model EventManagementSystem.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>Event Details</h1>

<div>

    <h2>@Model.Name</h2>

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Date:</strong>
        @Model.Date.ToString("dd MMMM yyyy")
    </p>

    <p>
        <strong>Start Time:</strong>
        @Model.StartTime.ToString(@"hh\:mm")
    </p>

    <p>
        <strong>End Time:</strong>
        @Model.EndTime.ToString(@"hh\:mm")
    </p>

    <p>
        <strong>Venue:</strong>
        @Model.Venue
    </p>

    <p>
        <strong>Maximum Attendees:</strong>
        @Model.MaximumAttendees
    </p>

</div>

<a asp-action="Edit"
   asp-route-id="@Model.Id">Edit Event</a>

|

<a asp-action="Index">Back to Events</a>