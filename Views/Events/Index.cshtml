@model List<EventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

<a asp-action="Create">Create New Event</a>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Date</th>
            <th>Time</th>
            <th>Venue</th>
            <th>Capacity</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var eventItem in Model)
        {
            <tr>
                <td>@eventItem.Name</td>
                <td>@eventItem.Date.ToString("dd MMM yyyy")</td>
                <td>
                    @eventItem.StartTime.ToString(@"hh\:mm")
                    -
                    @eventItem.EndTime.ToString(@"hh\:mm")
                </td>
                <td>@eventItem.Venue</td>
                <td>@eventItem.MaximumAttendees</td>
                <td>
                    <a asp-action="Details" asp-route-id="@eventItem.Id">Details</a>
                    <a asp-action="Edit" asp-route-id="@eventItem.Id">Edit</a>
                    <a asp-action="Delete" asp-route-id="@eventItem.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>