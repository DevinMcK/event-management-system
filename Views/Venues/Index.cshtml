@model List<EventManagementSystem.Models.Venue>

@{
    ViewData["Title"] = "Venues";
}

<h1>Venues</h1>

<a asp-action="Create">Create New Venue</a>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Capacity</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var venue in Model)
        {
            <tr>
                <td>@venue.Name</td>
                <td>@venue.Address</td>
                <td>@venue.Capacity</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@venue.Id">Details</a>

                    |

                    <a asp-action="Edit"
                       asp-route-id="@venue.Id">Edit</a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@venue.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>